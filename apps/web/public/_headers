# Response headers for the hosted web client on Cloudflare (Workers static assets).
# Vite copies this file to dist/ unchanged. See docs/web-deploy.md for why
# each directive is what it is; keep the two in step.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss: http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  ! Access-Control-Allow-Origin

# Vite puts a content hash in every file name under /assets, so a changed
# file always gets a new URL. Everything else (index.html, the SPA fallback,
# theme-boot.js) keeps the host's default of revalidating on every load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
