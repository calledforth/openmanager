{
  "expo": {
    "name": "OpenManager",
    "slug": "openmanager-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openmanager",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141414",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#141414"
      },
      "package": "com.openmanager.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenManager uses the camera to scan the pairing QR code your computer shows and to take photos you attach to a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenManager opens your photo library so you can attach photos to a message.",
          "cameraPermission": "OpenManager uses the camera to scan the pairing QR code your computer shows and to take photos you attach to a message.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
